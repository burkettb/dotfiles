[user]
	name = Brandon Burkett
	# The email lives in ~/.gitconfig.local (untracked, written by install.sh).
	# useConfigOnly makes git refuse to commit if it's missing instead of guessing.
	useConfigOnly = true

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input
	ignorecase = false

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[rebase]
	autoStash = true

[merge]
	tool = nvimdiff
	conflictstyle = diff3

[mergetool]
	prompt = false
	keepBackup = false

[diff]
	tool = nvimdiff
	colorMoved = default
	
[include]
	path = ~/.gitconfig.local

[url "git@github.com-icfcorp:ICF-Corp/"]
    insteadOf = git@github.com:ICF-Corp/

[includeIf "gitdir:~/dev-icfcorp/"]
    path = ~/.gitconfig-icfcorp
