#!/usr/bin/env bash
# Says what needs attention in ~/.dotfiles and prints nothing when all is well.
# New terminals, the tmux status bar and every new Claude session run this.
# "Behind" counts what the last fetch saw; the dotsync LaunchAgent fetches every
# 15 minutes, and this says so when those fetches stop working.
#
#   dotfiles-status         one line per problem
#   dotfiles-status --tmux  a compact status-bar segment, e.g. "dotfiles ↓2 ●1"
repo="$HOME/.dotfiles"
[[ -x $repo/install.sh ]] || exit 0
tmux=false
[[ ${1:-} == --tmux ]] && tmux=true
notes=() marks=()

# Links: a file was added, renamed, or deleted in home/, or an app replaced a link
if ! check=$("$repo/install.sh" --check 2>&1); then
    count=$(printf '%s\n' "$check" | wc -l | tr -d ' ')
    first=$(printf '%s\n' "$check" | head -1)
    (( count > 1 )) && first="$first (+$((count - 1)) more)"
    [[ $first == *gitconfig* ]] || first="$first. Run ~/.dotfiles/install.sh"
    notes+=("$first")
    marks+=("links")
fi

# Uncommitted edits: yours, or an app or agent writing through a link
changed=$(git -C "$repo" status --porcelain 2>/dev/null | cut -c4- | sed 's|^home/||')
if [[ -n $changed ]]; then
    count=$(printf '%s\n' "$changed" | wc -l | tr -d ' ')
    names=$(printf '%s\n' "$changed" | head -3 | paste -sd ',' - | sed 's/,/, /g')
    (( count > 3 )) && names="$names, ..."
    notes+=("$count uncommitted: $names")
    marks+=("●$count")
fi

# The checked-out branch is the live config, so say when it isn't main
branch=$(git -C "$repo" branch --show-current 2>/dev/null)
if [[ -n $branch && $branch != main ]]; then
    notes+=("on branch $branch, and that is your live config")
    marks+=("$branch")
fi

# Commits waiting either way, against the last fetched main. The message pins
# the commit, so applying can't pick up anything fetched after the review.
if counts=$(git -C "$repo" rev-list --left-right --count 'HEAD...origin/main' 2>/dev/null); then
    ahead=${counts%%[[:space:]]*}
    behind=${counts##*[[:space:]]}
    if (( behind > 0 )); then
        (( behind == 1 )) && n="1 commit" || n="$behind commits"
        tip=$(git -C "$repo" rev-parse --short origin/main)
        notes+=("~/.dotfiles is $n behind main: review with git -C ~/.dotfiles log -p HEAD..$tip, then dotsync --apply $tip")
        marks+=("↓$behind")
    fi
    if (( ahead > 0 )); then
        notes+=("$ahead commit(s) not on main")
        marks+=("↑$ahead")
    fi
fi

# Background fetches: not set up on this Mac, not running, or failing
# (offline, GitHub down). Any of those would hide new commits on main.
state="$HOME/.local/state/dotfiles"
old() { [[ ! -f $1 || -n $(find "$1" -mmin +60 2>/dev/null) ]]; }
if [[ ! -f $HOME/Library/LaunchAgents/com.burkettb.dotsync.plist ]]; then
    notes+=("nothing checks GitHub for changes. Run dotsync --install-agent once")
    marks+=("no-agent")
elif old "$state/last-attempt"; then
    notes+=("the dotsync LaunchAgent isn't running. Run dotsync --install-agent")
    marks+=("no-agent")
elif old "$state/last-success"; then
    notes+=("no successful fetch since $(cat "$state/last-success" 2>/dev/null || echo install). See ~/.local/state/dotfiles/sync.log")
    marks+=("fetch?")
fi

if $tmux; then
    # Catppuccin mocha yellow, matching the separators in ~/.tmux.conf
    (( ${#marks[@]} )) && printf '#[bg=#181825,fg=#f9e2af] dotfiles %s #[fg=#6c7086]│' "${marks[*]}"
else
    # Yellow in a terminal, plain text for agents reading it from a hook
    if [[ -t 1 ]]; then fmt='\033[33mdotfiles: %s\033[0m\n'; else fmt='dotfiles: %s\n'; fi
    for n in "${notes[@]}"; do printf "$fmt" "$n"; done
fi
exit 0
