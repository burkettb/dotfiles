#!/bin/zsh

set -u

# agent-doctor [--profile workspace|agent-box]
# Without the flag the profile comes from ~/.config/agent/profile (linked from
# hosts/<name>/ on a machine that has one), else workspace.
usage() { printf 'usage: agent-doctor [--profile workspace|agent-box]\n'; }
profile_file="$HOME/.config/agent/profile"
profile=""
while (( $# )); do
  case $1 in
    --profile) (( $# >= 2 )) || { usage >&2; exit 2; }; profile=$2; shift ;;
    --profile=*) profile=${1#--profile=} ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done
if [[ -z "$profile" && -f "$profile_file" ]]; then
  profile=$(head -1 "$profile_file" | tr -d '[:space:]')
fi
profile=${profile:-workspace}
case $profile in
  workspace|agent-box) ;;
  *) printf 'unknown profile: %s\n' "$profile" >&2; usage >&2; exit 2 ;;
esac
printf 'profile: %s\n' "$profile"

failures=0
warnings=0

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; failures=$((failures + 1)); }
warn() { printf 'WARN  %s\n' "$1"; warnings=$((warnings + 1)); }

require_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "$1 is installed"
  else
    fail "$1 is not installed"
  fi
}

for command_name in jq rg git codex claude devcenter; do
  require_command "$command_name"
done

if dotfiles_check=$("$HOME/.dotfiles/install.sh" --check 2>&1); then
  pass 'every dotfile is linked into the repo'
else
  warn 'some dotfiles are not linked; run ~/.dotfiles/install.sh'
  printf '%s\n' "$dotfiles_check"
fi

if jq empty "$HOME/.claude/settings.json" >/dev/null 2>&1; then
  pass 'Claude settings are valid JSON'
else
  fail 'Claude settings are invalid JSON'
fi

# `codex plugin list` parses config.toml and fails on invalid TOML;
# `codex --help` exits 0 regardless and proves nothing.
if codex plugin list >/dev/null 2>&1; then
  pass 'Codex parses the managed config'
else
  fail 'Codex could not parse the managed config'
fi

claude_plugin_json=$(claude plugin list --json 2>/dev/null) || claude_plugin_json='[]'
for plugin in 'typescript-lsp@claude-plugins-official' 'codex@openai-codex' 'thread-card@dotfiles'; do
  if jq -e --arg p "$plugin" 'map(select(.id == $p and .enabled == true)) | length == 1' <<<"$claude_plugin_json" >/dev/null; then
    pass "Claude plugin enabled: $plugin"
  else
    fail "Claude plugin not enabled: $plugin"
  fi
  if claude plugin details "$plugin" >/dev/null 2>&1; then
    pass "Claude plugin resolves: $plugin"
  else
    fail "Claude plugin details failed: $plugin"
  fi
done

for required_file in \
  "$HOME/.codex/AGENTS.md" \
  "$HOME/.codex/config.toml" \
  "$HOME/.claude/CLAUDE.md" \
  "$HOME/.claude/settings.json"; do
  if [[ -f "$required_file" ]]; then
    pass "$required_file exists"
  else
    fail "$required_file is missing"
  fi
done

if rg -q '"disableBypassPermissionsMode": "disable"' "$HOME/.claude/settings.json"; then
  pass 'Claude bypass-permissions mode is disabled'
else
  fail 'Claude bypass-permissions mode is not disabled'
fi

# What Codex is allowed depends on the profile: workspace keeps the sandbox,
# agent-box (a machine where agents run with full access on purpose) drops it.
# Only top-level keys count (a [profiles.x] table can set its own), comments dropped.
codex_mode=$(awk '/^[[:space:]]*\[/ { exit }
  { sub(/[[:space:]]*#.*/, ""); sub(/[[:space:]]*=[[:space:]]*/, " = "); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
  /^(default_permissions|sandbox_mode) ?=/ { print }' "$HOME/.codex/config.toml" 2>/dev/null)
case $profile in
  workspace) want='default_permissions = "safe-workspace"' ;;
  agent-box) want='sandbox_mode = "danger-full-access"|default_permissions = ":danger-full-access"' ;;
esac
if [[ -n "$codex_mode" ]] && printf '%s\n' "$codex_mode" | rg -qx "$want"; then
  pass "Codex permissions match the $profile profile: ${codex_mode//$'\n'/, }"
else
  fail "Codex permissions don't match the $profile profile: ${${codex_mode//$'\n'/, }:-none set}"
fi

# The guard hook has to deny credential reads, not just exist
guard="$HOME/.claude/hooks/guard-bash.sh"
guard_out=$(printf '%s' '{"tool_input":{"command":"cat ~/.aws/credentials"}}' | "$guard" 2>/dev/null)
if [[ "$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$guard_out" 2>/dev/null)" == deny ]]; then
  pass 'guard hook denies a credential read'
else
  fail "guard hook did not deny a credential read ($guard)"
fi

if rg -q 'github_pat_|ghp_[A-Za-z0-9]|ctx7sk-|BEGIN .*PRIVATE KEY' \
  "$HOME/.codex/config.toml" "$HOME/.claude/settings.json"; then
  fail 'a plaintext credential pattern was found in managed agent config'
else
  pass 'no known plaintext credential patterns found'
fi

# settings.json is a public file in the repo, so only the Codex config, which
# Codex fills with machine-local state, needs to stay private.
if [[ "$(stat -f '%Lp' "$HOME/.codex/config.toml" 2>/dev/null)" == '600' ]]; then
  pass 'Codex config is mode 0600'
else
  fail 'Codex config is not mode 0600'
fi

if devcenter_home=$(devcenter home 2>/dev/null) && [[ -n "$devcenter_home" ]]; then
  pass "DevCenter home: $devcenter_home"
else
  warn 'DevCenter home is not configured'
fi

printf '\n%d failure(s), %d warning(s)\n' "$failures" "$warnings"
(( failures == 0 ))
