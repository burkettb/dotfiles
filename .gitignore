# macOS
.DS_Store
._*

# Vim/Neovim swap and runtime files
*.swp
*.swo
*.swn
.netrwhist

# Secrets and credentials
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

nvim.log

# This repo's own Claude Code session data (home/.claude is the real ~/.claude).
/.claude/

# DevCenter's .git/info/exclude hides CLAUDE.md and AGENTS.md anywhere (for its
# links at the repo root); the real agent files under home/ must stay tracked.
!/home/.claude/CLAUDE.md
!/home/.codex/AGENTS.md
